# The server is loopback-only by default. Set 0.0.0.0 only behind a trusted proxy.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=4400
ORCHESTRATOR_DATA_DIR=./data

# Required when binding beyond loopback. Generate with: openssl rand -base64 32
# ORCHESTRATOR_MASTER_KEY=

# Comma-separated public origins allowed to make browser requests.
ORCHESTRATOR_ALLOWED_ORIGINS=http://127.0.0.1:4400,http://localhost:4400

# Proxy ranges allowed to supply X-Forwarded-* headers. Native Tailscale Serve needs only loopback.
ORCHESTRATOR_TRUST_PROXY=loopback

# Development only: bypasses sign-in and seeds representative local data.
# ORCHESTRATOR_DEMO=1

# Optional absolute JS entry for nonstandard Windows OpenClaw installations.
# ORCHESTRATOR_OPENCLAW_ENTRY=C:/path/to/openclaw/openclaw.mjs

# Optional: enables the Phone control server proxy to the separate loopback broker.
# Use the broker's private owner token. Never give this credential to source agents.
# See docs/android-phone-control.md; agents receive their own scoped credentials.
# ORCHESTRATOR_PHONE_BROKER_TOKEN=
# Required alongside that token: the trusted broker-public.pem contents as raw
# PEM with real newlines, not a file path or the broker-signing.pem private key.
# Provision through the owner's startup environment. PowerShell example:
# $env:ORCHESTRATOR_PHONE_BROKER_PUBLIC_KEY = Get-Content -Raw -LiteralPath C:/private/broker-public.pem
# ORCHESTRATOR_PHONE_BROKER_PUBLIC_KEY=
