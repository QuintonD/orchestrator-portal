{
  "name": "orchestrator-portal",
  "version": "0.1.0-alpha.8",
  "orchestratorRelease": {
    "previousVersion": "0.1.0-alpha.7",
    "previousCompanionVersion": "0.1.0-alpha.2"
  },
  "private": true,
  "description": "A local-first command centre for personal AI assistants.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "assets:assistant-motion": "tsx --tsconfig apps/web/tsconfig.json scripts/export-assistant-motion.mts",
    "desktop:package": "npm run build && node scripts/desktop/package.mjs",
    "desktop:test": "node --test scripts/desktop/paths.test.mjs scripts/desktop/staging.test.mjs",
    "desktop:smoke": "node scripts/desktop/smoke.mjs",
    "android:build": "node scripts/android-build.mjs",
    "phone:android:build": "node scripts/phone-android-build.mjs",
    "phone:test": "npm test --prefix components/phone-control",
    "phone:test:native": "node tests/phone-control/native.mjs",
    "phone:test:integration": "node tests/phone-control/integration.mjs",
    "phone:test:agents": "node tests/phone-control/agent-session.mjs",
    "phone:test:document": "node tests/phone-control/document.mjs",
    "phone:test:evaluation": "node --test tests/phone-control/evaluation/*.test.mjs",
    "phone:license:check": "node scripts/phone-control-license-check.mjs",
    "test:android": "node tests/android/qa.mjs",
    "test:android:release": "node tests/android/release.mjs",
    "build": "npm run build -w @orchestrator/contracts && npm run build -w @orchestrator/adapter-sdk && npm run build -w @orchestrator/web && npm run build -w @orchestrator/server",
    "check": "npm run typecheck && npm run test",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @orchestrator/server\" \"npm run dev -w @orchestrator/web\"",
    "dev:demo": "cross-env ORCHESTRATOR_DEMO=1 concurrently -k -n api,web -c blue,magenta \"npm run dev -w @orchestrator/server\" \"npm run dev -w @orchestrator/web\"",
    "start": "cross-env NODE_ENV=production npm run start -w @orchestrator/server",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run build -w @orchestrator/contracts && npm run build -w @orchestrator/adapter-sdk && npm run typecheck -w @orchestrator/server && npm run typecheck -w @orchestrator/web",
    "demo": "npm run build && node scripts/demo.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:test": "node --test scripts/release-*.test.mjs tests/release-upgrade-records.test.mjs tests/android/release-evidence.test.mjs tests/android/native-password.test.mjs",
    "test:upgrade": "node tests/release-upgrade.mjs",
    "phone:test:isolation": "node --test components/phone-control/test/isolation-container.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "typescript": "7.0.2"
  }
}
